# Port — Render sets this automatically; locally defaults to 3000.
PORT=3000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/chat_2
# Prod:   use a MongoDB Atlas URI (mongodb+srv://...)
MONGODB_URI=

# JWT signing secret. Generate a fresh value for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Comma-separated list of allowed frontend origins (no trailing slash).
# Prod example: https://your-app.vercel.app
# Leave empty in dev to allow all origins.
ALLOWED_ORIGINS=

# Set to "production" on the host.
NODE_ENV=production
